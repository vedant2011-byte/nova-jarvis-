# JARVIS environment configuration (optional)
# Copy to .env and edit if needed. Never commit real secrets.
# .env is git-ignored; real environment variables always override it.

# Where settings/database/logs/screenshots live
JARVIS_DATA_DIR=
JARVIS_LOG_DIR=

# Google Gemini API (hosted chat provider) — create a key at
# https://aistudio.google.com/apikey and paste it here for LOCAL development.
# On Vercel, set GEMINI_API_KEY in the API service's environment variables
# instead — never in frontend/VITE variables and never in Git.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite, stable + free tier)
GEMINI_MODEL=

# LLM runtime (Ollama) — host only; the model is chosen in the app settings
OLLAMA_HOST=http://127.0.0.1:11434
